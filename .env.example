# AK-Bench local environment.
# Loaded automatically by the CLI, the UI and scripts/run-postgres.sh.
# Real environment variables always win over values from this file.

# --- PostgreSQL connection (scripts/run-postgres.sh reads the same names) ---
AKBENCH_PG_HOST=127.0.0.1
AKBENCH_PG_PORT=5959
AKBENCH_PG_USER=akbench
# Required, with no default anywhere. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# The helper script refuses to start a database without it, and refuses a
# password it can see through (see scripts/run-postgres.sh).
AKBENCH_PG_PASSWORD=
AKBENCH_PG_DB=akbench

# Docker container used by scripts/run-postgres.sh
AKBENCH_PG_IMAGE=postgres:18
AKBENCH_PG_CONTAINER=akbench-postgres
AKBENCH_PG_VOLUME=akbench-postgres-data

# --- Database backend: postgres (default) or sqlite ---
AKBENCH_DB_BACKEND=postgres
