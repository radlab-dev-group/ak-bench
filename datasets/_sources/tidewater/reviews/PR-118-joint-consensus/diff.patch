+def configuration_in_force(log, base: Configuration) -> Configuration | JointConfiguration:
+    """The configuration a node counts against (``SPEC.md`` 7.1).
+
+    The latest ``config`` entry in the log is the one in force, committed or
+    not: a joint entry brings ``C_old,new`` in, and the cluster goes back to
+    counting a single majority once the change has a decision behind it.
+    """
+
+    latest = None
+    for entry in log.entries():
+        if getattr(entry, "kind", "") == "config":
+            latest = entry
+    if latest is None:
+        return base
+    payload = latest.payload
+    if payload.get("config") == "final":
+        return Configuration.of(payload["new"])
+    joint = JointConfiguration(
+        Configuration.of(payload["old"]), Configuration.of(payload["new"])
+    )
+    if log.commit_index >= latest.index:
+        # The joint entry is committed, so the change is decided and the cluster
+        # can go back to counting one majority instead of two.
+        return joint.new
+    return joint
