+    def _finish_membership_change(self) -> None:
+        """Hand the leadership over when a change leaves the leader out (7.5)."""
+
+        if not isinstance(self.config, JointConfiguration):
+            return
+        if self.node_id in self.config.new.voters:
+            return
+        joint_index = next(
+            (
+                entry.index
+                for entry in reversed(self.log.entries())
+                if getattr(entry, "kind", "") == "config"
+                and entry.payload.get("config") == "joint"
+            ),
+            None,
+        )
+        if joint_index is None or self.commit_index < joint_index:
+            return
+        self.trace.record(self.global_tick, self.node_id, "membership_step_down",
+                          term=self.current_term, committed=self.commit_index)
+        self._become_follower(self.current_term, reason="removed_by_membership_change")
+
